{
  "Routes": [
    //Authentication Web API
    {
      "UpstreamPathTemplate": "/Account",
      "UpstreamHttpMethod": [ "Post" ],
      "DownstreamPathTemplate": "/api/Account",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "authenticationwebapi",
          "Port": 8086
        }
      ]
    },
    //Product Catalog
    {
      "DownstreamPathTemplate": "/api/Product",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ecommerce.webapi",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/Product",
      "UpstreamHttpMethod": [ "Get", "Post", "Put" ],
      "FileCacheOptions": { "TtlSeconds": 30 },
      "RateLimitOptions": {
        // rule, partition by
        "ClientIdHeader": "",
        "ClientWhitelist": [ "" ],
        // management opts
        "EnableRateLimiting": true,
        "EnableHeaders": true,
        // algorithm
        "Limit": 1,
        "Period": "",
        "Wait": "",
        // extended opts
        "StatusCode": 1,
        "QuotaMessage": "",
        "KeyPrefix": ""
      }
    },
    {
      "DownstreamPathTemplate": "/api/Product/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "ecommerce.webapi",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/Product/{id}",
      "UpstreamHttpMethod": [ "Get", "Delete" ]
    },
    //Shopping Cart
    {
      "DownstreamPathTemplate": "/api/ShoppingCart",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "shoppingcart.webapi",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/ShoppingCart",
      "UpstreamHttpMethod": [ "Get", "Post", "Put" ]
    },
    {
      "DownstreamPathTemplate": "/api/ShoppingCart/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "shoppingcart.webapi",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/ShoppingCart/{id}",
      "UpstreamHttpMethod": [ "Get", "Delete" ]
    },
    {
      "DownstreamPathTemplate": "/api/ShoppingCart/Checkout",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "shoppingcart.webapi",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/ShoppingCart/Checkout",
      "UpstreamHttpMethod": [ "Post" ]
    },
    //Discount
    {
      "DownstreamPathTemplate": "/api/Discount",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "discount.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/Discount",
      "UpstreamHttpMethod": [ "Post", "Put" ]
    },
    {
      "DownstreamPathTemplate": "/api/Discount/{productId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "discount.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/Discount/{productId}",
      "UpstreamHttpMethod": [ "Get", "Delete" ]
    },
    //Order
    {
      "DownstreamPathTemplate": "/api/Order/{userName}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "order.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/Order/{userName}",
      "UpstreamHttpMethod": [ "Get" ]
    },

    //User
    {
      "DownstreamPathTemplate": "/api/User",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "user.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/User",
      "UpstreamHttpMethod": [ "Get", "Post", "Put" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "RouteClaimsRequirement": {
        "Role": "Administrator"
      }
    },
    {
      "DownstreamPathTemplate": "/api/User/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "user.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/User/{id}",
      "UpstreamHttpMethod": [ "Get", "Delete" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5141",
    "RateLimitOptions": {
      "QuotaExceedMessage": "Request not allowed",
      "HttpStatusCode": 909
    }
  }
}
