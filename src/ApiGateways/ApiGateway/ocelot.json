{
  "Routes": [
    //Identity Web API
    {
      "UpstreamPathTemplate": "/Account/{action}",
      "UpstreamHttpMethod": [ "Get", "Post" ],
      "DownstreamPathTemplate": "/api/Account/{action}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identitywebapi",
          "Port": 8080
        }
      ]
    },
    //Product Catalog
    {
      "DownstreamPathTemplate": "/api/Catalog",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "productcatalog.webapi",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/Catalog",
      "UpstreamHttpMethod": [ "Get", "Post", "Put" ],
      "FileCacheOptions": { "TtlSeconds": 30 }
    },
    {
      "DownstreamPathTemplate": "/api/Catalog/GetProductByName/{name}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "productcatalog.webapi",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/Catalog/GetProductByName/{name}",
      "UpstreamHttpMethod": [ "Get" ]
    },
    {
      "DownstreamPathTemplate": "/api/Catalog/GetProductByCategory/{category}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "productcatalog.webapi",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/Catalog/GetProductByCategory/{category}",
      "UpstreamHttpMethod": [ "Get" ]
    },
    {
      "DownstreamPathTemplate": "/api/Catalog/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "productcatalog.webapi",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/Catalog/{id}",
      "UpstreamHttpMethod": [ "Get", "Delete" ]
    },
    //Shopping Cart
    {
      "DownstreamPathTemplate": "/api/ShoppingCart",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "shoppingcart.webapi",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/ShoppingCart",
      "UpstreamHttpMethod": [ "Get", "Post", "Put" ]
    },
    {
      "DownstreamPathTemplate": "/api/ShoppingCart/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "shoppingcart.webapi",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/ShoppingCart/{id}",
      "UpstreamHttpMethod": [ "Get", "Delete" ]
    },
    {
      "DownstreamPathTemplate": "/api/ShoppingCart/Checkout",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "shoppingcart.webapi",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/ShoppingCart/Checkout",
      "UpstreamHttpMethod": [ "Post" ]
    },
    //Discount
    {
      "DownstreamPathTemplate": "/api/Discount",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "discount.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/Discount",
      "UpstreamHttpMethod": [ "Post", "Put" ]
    },
    {
      "DownstreamPathTemplate": "/api/Discount/{productId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "discount.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/Discount/{productId}",
      "UpstreamHttpMethod": [ "Get", "Delete" ]
    },
    //Order
    {
      "DownstreamPathTemplate": "/api/Order/{userName}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "order.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/Order/{userName}",
      "UpstreamHttpMethod": [ "Get" ]
    },

    //User
    {
      "DownstreamPathTemplate": "/api/User",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "user.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/User",
      "UpstreamHttpMethod": [ "Get", "Post", "Put" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "RouteClaimsRequirement": {
        "Role": "Administrator"
      }
    },
    {
      "DownstreamPathTemplate": "/api/User/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "user.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/User/{id}",
      "UpstreamHttpMethod": [ "Get", "Delete" ]
    },

    //Notification
    {
      "DownstreamPathTemplate": "/api/Notification",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "notification.webapi",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/Notification",
      "UpstreamHttpMethod": [ "Get" ]
    },
    {
      "DownstreamPathTemplate": "/api/Notification/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "notification.webapi",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/Notification/{id}",
      "UpstreamHttpMethod": [ "Get" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5141",
    "RateLimitOptions": {
      "QuotaExceedMessage": "Request not allowed",
      "HttpStatusCode": 909
    }
  }
}
